# SuperAgent 环境变量示例。复制为 .env（已 gitignore），填入真实值。

# 提供商：deepseek | zhipu | bailian | openai | auto | mock | null
# 预设已内置 base_url 与默认模型，可直接用提供商名切换
SUPERAGENT_LLM_PROVIDER=deepseek

# DeepSeek（默认，deepseek-chat）
DEEPSEEK_API_KEY=sk-你的deepseek密钥

# 智谱 GLM（glm-4-flash）
ZHIPU_API_KEY=你的智谱id.secret

# 阿里云百炼 Qwen（qwen-plus）
BAILIAN_API_KEY=sk-你的百炼密钥

# 通用 OpenAI（provider=openai 时使用）
SUPERAGENT_LLM_API_KEY=sk-你的openai密钥
OPENAI_API_KEY=sk-你的openai密钥

# 可选：覆盖模型 / base_url（对所有提供商生效）
# SUPERAGENT_LLM_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1
